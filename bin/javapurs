#!/usr/bin/env bash
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"

command -v node >/dev/null 2>&1 || { echo "javapurs: Node.js is required on PATH (see README prerequisites)." >&2; exit 1; }
exec node --expose-gc --stack-size=65536 --max-old-space-size="${JAVAPURS_HEAP:-16384}" "$DIR/javapurs.js" "$@"
